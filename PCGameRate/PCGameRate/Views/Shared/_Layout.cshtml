@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager
@{  
    string fullName = "Невідомий користувач"; // Значення за замовчуванням
    if (User.Identity.IsAuthenticated)
    {
        var user = await UserManager.GetUserAsync(User);
        fullName = user?.FullName ?? user.UserName ?? "Невідомий користувач";
    }
    <title>@(ViewData["Title"] != null ? ViewData["Title"] : "Default Title")</title>
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="errorToast" class="toast align-items-center text-white bg-danger border-0 position-fixed top-0 end-0 m-3"
             role="alert" aria-live="assertive" aria-atomic="true" style="z-index: 1050;">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var errorToast = new bootstrap.Toast(document.getElementById('errorToast'));
                errorToast.show();
            });
        </script>
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PCGameRate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PCGameRate.styles.css" asp-append-version="true" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PCGameRate</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex">
                    <ul class="navbar-nav flex-grow-1 d-flex  align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Game" asp-action="Index">Ігри</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Game" asp-action="Top100">Топ 100 ігор</a>
                        </li>
                        <li class="align-items-center">
                            <form asp-controller="Game" asp-action="SearchResults" method="get" class="d-flex" style="margin-top: 16px;">
                                <input type="text" id="searchBox" name="query" class="form-control me-2 fixhight" placeholder="Пошук ігор..." autocomplete="off" />
                                <button type="submit" class="btn btn-outline-secondary place-b btn:hover" style="margin-top: 0px;">🔍</button>
                            </form>
                            <div id="suggestions" class="suggestions-box"></div>
                        </li>
                    </ul>
                    <ul class="navbar-nav ml-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <ul class="navbar-nav align-items-center">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @await Html.PartialAsync("_UserProfileIcon")
                                        @fullName
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                        <li><a class="dropdown-item" style="color: black; margin: 0px 0px 0px 0px;" asp-controller="Rating" asp-action="RatingList">Оцінені ігри</a></li>
                                        <li><a class="dropdown-item" style="color: black; margin: 0px 0px 0px 0px;" asp-controller="Review" asp-action="ReviewList">Написані рецензії</a></li>
                                        <li><a class="dropdown-item" style="color: black; margin: 0px 0px 0px 0px;" asp-controller="GameList" asp-action="Index">Ігри на майбутнє</a></li>
                                        <li><a class="dropdown-item" style="color: black; margin: 0px 0px 0px 0px;" asp-controller="Account" asp-action="Recommendations">Рекомендації</a></li>
                                        <li><a class="dropdown-item" style="color: black; margin: 0px 0px 0px 0px;" asp-controller="Account" asp-action="Profile">Налаштування акаунта</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">Вихід</a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Вхід</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Реєстрація</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - PCGameRate - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/search.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
