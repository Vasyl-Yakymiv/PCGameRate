@model Game

@{
    ViewData["Title"] = "Оцінити гру";
    var existingRating = ViewBag.ExistingRating as int?;
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
<script src="~/js/rate-game.js"></script>
<link rel="stylesheet" href="~/css/rate.css" />

<div class="container">
    <h1>Оцінка гри: @Model.Title</h1>

    <div>
        <p>
            Ваша поточна оцінка: @if (existingRating.HasValue)
            {
                <strong>@existingRating</strong>
            }
            else
            {
                <em>Ще не оцінено</em>
            }
        </p>
    </div>

    <form asp-action="RateGame" asp-controller="Rating" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="gameId" value="@Model.GameId" />

        <div class="rating-stars" id="ratingStars">
            @for (int i = 1; i <= 10; i++)
            {
                <span class="star" data-value="@i"><i class="fas fa-star"></i></span>
            }
        </div>

        <input type="hidden" id="selectedRating" name="ratingValue" value="@existingRating" />

        <button type="submit" class="btn btn-primary">Оцінити</button>
    </form>


    <div>
        <canvas id="ratingChart" width="400" height="200"></canvas>
    </div>
</div>

<style>
    #ratingChart {
        max-width: 100%;
        margin: 30px auto;
        height: 400px;
    }
    .rating-stars {
        display: flex;
        gap: 5px;
        justify-content: center;
        font-size: 40px;
        cursor: pointer;
    }

    .star {
        color: #ccc; 
    }

        .star.filled {
            color: gold; 
        }

        .star.hover {
            color: lightgoldenrodyellow;
        }

    .btn {
        margin-top: 20px;
    }
</style>

<script>
    
    var gameId = @Model.GameId;

    fetch('/Game/GetRatingStats?gameId=' + gameId)
        .then(response => response.json())
        .then(data => {
            var ratingValues = [];
            var ratingCounts = [];

            
            var ratingData = {};

           
            data.forEach(item => {
                ratingData[item.ratingValue] = item.count;
            });

        
            for (var i = 1; i <= 10; i++) {
                ratingValues.push(i);
                ratingCounts.push(ratingData[i] || 0); 
            }

           
            var ctx = document.getElementById('ratingChart').getContext('2d');
            var chart = new Chart(ctx, {
                type: 'bar', 
                data: {
                    labels: ratingValues, 
                    datasets: [{
                        data: ratingCounts, 
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    indexAxis: 'y', 
                    scales: {
                        x: {
                            beginAtZero: true,
                            display: false,
                            title: {
                                display: true,
                            },
                            grid: {
                                display: false 
                            }
                        },
                        y: {
                            title: {
                                display: true,
                            },
                            grid: {
                                display: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false 
                        }
                    }
                }
            });
        })
        .catch(error => console.error('Error fetching rating stats:', error));


</script>





