@model List<GameListItem>

@{
    ViewData["Title"] = "Ігри на майбутнє";
}


<link rel="stylesheet" href="~/css/rating-list.css" />
<div class="container">
    <div class="row mb-3">
        <div class="col-12">
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false" style="border: none">
                    Сортувати за
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <li><a class="dropdown-item" href="@Url.Action("Index", "GameList", new { sortOrder = "releaseDate_asc" })">Дата релізу (за зростанням)</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "GameList", new { sortOrder = "releaseDate_desc" })">Дата релізу (за спаданням)</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "GameList", new { sortOrder = "rating_asc" })">Рейтинг гри (за зростанням)</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "GameList", new { sortOrder = "rating_desc" })">Рейтинг гри (за спаданням)</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var game in Model)
        {
            <div class="col">
                <div class="card shadow-sm rounded-3 game-item" style="overflow: hidden; border: none; height: 100%;">
                    <img class="card-img-top" src="@game.Game.Image" alt="@game.Game.Title">

                    <div class="card-body">
                        <h5 class="card-title fw-bold text-primary title">@game.Game.Title</h5>
                        <p class="text-muted small mb-2"><span class="fw-semibold">📅 @game.Game.ReleaseDate</span></p>
                        <p class="text-muted small mb-2">⭐ <span class="fw-semibold"> @game.Game.RatingAverage?.ToString("0.0")</span></p>
                        <p class="text-muted small mb-2">Розробник: <span class="fw-semibold"> @game.Game.Developer.DeveloperName</span></p>
                        <p class="text-muted small mb-2">Жанр: <span class="fw-semibold"> @game.Game.Genre.GameGenre</span></p>
                    </div>

                    <div class="card-footer d-flex justify-content-between game-item">
                        <a type="button" class="btn btn-outline-info btn-sm" asp-controller="Game" asp-action="Detail" asp-route-id="@game.GameId">
                            <i class="bi bi-eye"></i> Перейти до гри
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<style>
    .dropdown-item {
        padding: 10px 20px;
        color: #000;
        transition: background-color 0.3s ease;
    }

        .dropdown-item:hover {
            background-color: #4682B4;
            color: #000;
        }
</style>

