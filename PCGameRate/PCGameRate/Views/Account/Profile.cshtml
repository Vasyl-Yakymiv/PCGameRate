@using PCGameRate.ViewModels.Account
@model ProfileViewModel
@{
    ViewData["Title"] = "Профіль користувача";
}

<link rel="stylesheet" href="~/css/profile.css" />

<div class="profile-container" style="margin-top: 15px;">
    <h2>Профіль користувача</h2>

    <form asp-action="Profile" method="post" enctype="multipart/form-data">
        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
        {
            <div class="profile-image-container">
                <img src="@Model.ProfileImageUrl" alt="Зображення профілю" class="profile-image" />
            </div>
        }
        <div>
            <label asp-for="FullName"></label>
            <input asp-for="FullName" />
        </div>

        <div>
            <label for="ProfileImage">Завантажити новий аватар</label>
            <input type="file" asp-for="ProfileImage" id="ProfileImage" />
        </div>

        <button type="submit">Зберегти зміни</button>
    </form>
</div>

