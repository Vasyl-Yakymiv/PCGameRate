﻿@using PCGameRate.ViewModels.Account
@model LoginViewModel
@{
    ViewData["Title"] = "Вхід";
    ViewData["HideHeader"] = true; 
}
<head>
    <link rel="stylesheet" href="~/css/auth.css"/>
    <style>
        header {
            display: none;
        }
    </style>
</head>
<body>
    <div class="login-container" style="margin-top: 15px;">
        <h4>Вхід до вашого акаунта</h4>
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <span><b>Вибачте!</b> - @TempData["Error"]</span>
            </div>
        }
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="EmailAddress" class="control-label"></label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input class="btn btn-outline-secondary" type="submit" value="Увійти" />
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Скасувати</a>
            </div>
        </form>
    </div>
</body>
