@using PCGameRate.ViewModels.Game
@model GameListViewModel
@{
    ViewData["Title"] = "Ігри";
}
<link rel="stylesheet" href="~/css/gameindex.css" />
<div class="container" style="margin: 0px 0px 0px 50px;">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" style="width:1400px">
        @foreach (var game in Model.Games)
        {
            <div class="col" style="width: 329px;">
                <div class="card shadow-sm rounded-3 game-item" style="overflow: hidden; border: none; height: 100%">
                    <img class="card-img-top" src="@game.Image" alt="@game.Title">

                    <div class="card-body">
                        <h5 class="card-title fw-bold text-primary title">@game.Title</h5>
                        <p class="text-muted small mb-2"><span class="fw-semibold">📅 @game.ReleaseDate</span></p>
                        <p class="text-muted small mb-2">⭐ @game.RatingAverage?.ToString("0.0") (на основі @game.RatingCount оцінок)</p>
                        <p class="text-muted small mb-2">Розробник: <span class="fw-semibold">@game.Developer.DeveloperName</span></p>
                        <p class="text-muted small mb-2">Жанр: <span class="fw-semibold">@game.Genre.GameGenre</span></p>
                    </div>

                    <div class="card-footer d-flex justify-content-between game-item">
                        <a type="button" class="btn btn-outline-info btn-sm" asp-controller="Game" asp-action="Detail" asp-route-id="@game.GameId">
                            <i class="bi bi-eye"></i> Детальна інформація
                        </a>
                        @if (User.IsInRole("admin"))
                        {
                            <a type="button" class="btn btn-outline-warning btn-sm" asp-controller="Game" asp-action="Edit" asp-route-id="@game.GameId">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a type="button" class="btn btn-outline-danger btn-sm" asp-controller="Game" asp-action="Delete" asp-route-id="@game.GameId">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="1">&laquo; Перша</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.CurrentPage - 1">Попередня</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.CurrentPage + 1">Наступна</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages">Остання &raquo;</a>
                </li>
            }
        </ul>
    </div>
</div>
