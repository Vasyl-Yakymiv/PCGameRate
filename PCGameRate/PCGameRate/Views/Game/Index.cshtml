@model IEnumerable<Game>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="container">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var game in Model)
        {
            <div class="col">
                <div class="card shadow-sm rounded-3" style="overflow: hidden; border: none; height: 100%;">
                    <img class="card-img-top" src="@game.Image" alt="@game.Title">

                    <div class="card-body">
                        <h5 class="card-title fw-bold text-primary">@game.Title</h5>
                        <p class="text-muted small mb-2"><span class="fw-semibold">@game.ReleaseDate</span></p>
                        <p class="text-muted small mb-2">Рейтинг: <span class="fw-semibold">@game.RatingAverage</span></p>
                        <p class="text-muted small mb-2">Розробник: <span class="fw-semibold">@game.Developer.DeveloperName</span></p>
                        <p class="text-muted small mb-2">Жанр: <span class="fw-semibold">@game.Genre.GameGenre</span></p>
                    </div>

                    <div class="card-footer d-flex justify-content-between bg-light">
                        <a type="button" class="btn btn-outline-info btn-sm" asp-controller="Game" asp-action="Detail" asp-route-id="@game.GameId">
                            <i class="bi bi-eye"></i> Detail
                        </a>
                        <a type="button" class="btn btn-outline-warning btn-sm" asp-controller="Game" asp-action="Edit" asp-route-id="@game.GameId">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a type="button" class="btn btn-outline-danger btn-sm" asp-controller="Game" asp-action="Delete" asp-route-id="@game.GameId">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>