@model Game

<div class="container mt-5">
    <div class="row">
      
        <div class="col-md-6">
            <img src="@Model.Image" class="img-fluid rounded shadow" alt="Game Image" />
        </div>

       
        <div class="col-md-6">
            <h1>@Model.Title</h1>
            <p class="text-muted"></p>
            <p>@Model.Description</p>
            <div class="d-flex align-items-center">
                <p>Рейтинг: @Model.RatingAverage?.ToString("0.0") (на основі @Model.RatingCount оцінок)</p>
            </div>
           @if (User.Identity.IsAuthenticated)
           {  
            <div>
                <h3>
                    Ваш рейтинг: @if (ViewBag.UserRating != null)
                    {
                        <span>@ViewBag.UserRating</span>
                    }
                    else
                    {
                        <span>Не оцінено</span>
                    }
                </h3>
                <a asp-action="RateGame" asp-controller="Rating" asp-route-gameId="@Model.GameId" class="btn btn-success">
                    Оцінити гру
                </a>
                </div>
            }
        </div>
    </div>

    <div class="mt-5">
        <h3>Gallery</h3>
        <div id="game-gallery" class="carousel slide" data-bs-ride="carousel">
            @* <div class="carousel-inner">
                @for (var i = 0; i < Model.Image.Count; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@Model.Images[i]" class="d-block w-100 rounded shadow" alt="Gallery Image @i" />
                    </div>
                }
            </div> *@
            @* <button class="carousel-control-prev" type="button" data-bs-target="#game-gallery" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#game-gallery" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button> *@
        </div>
    </div>
     @if (User.Identity.IsAuthenticated)
    { 
    <div>
    <a asp-action="Create" asp-controller="Review" asp-route-gameId="@Model.GameId" class="btn btn-success">Написати рецензію</a>
    </div>
    }
    <h3>Рецензії</h3>
    @if (Model.Reviews != null && Model.Reviews.Any())
    {
    @foreach (var review in Model.Reviews)
        {
            <div class="review">
                <p class="review-header">
                    <strong>@review.User.UserName</strong> - @review.DatePosted?.ToString("dd.MM.yyyy")
                </p>
                <p class="review-text">@review.ReviewText</p>
            </div>
        }
    }
    else
    {
        <p>Немає рецензій для цієї гри.</p>
    }
</div>