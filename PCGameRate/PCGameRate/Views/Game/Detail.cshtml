@model Game
@{
    ViewData["Title"] = Model.Title;
}
<link rel="stylesheet" href="~/css/carousel.css" />
<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.Image" class="img-fluid rounded shadow" alt="Game Image" />
        </div>

        <div class="col-md-6">
            <h1>@Model.Title</h1>
            <p class="text-muted"></p>
            <p>@Model.Description</p>
            @if (!Model.IsExpected)
            {
                <div class="d-flex align-items-center">
                    <p>⭐ @Model.RatingAverage?.ToString("0.0") (на основі @Model.RatingCount оцінок)</p>
                </div>
            }
            @if (User.Identity.IsAuthenticated && !Model.IsExpected)
            {
                <div>
                    <h3>
                        Ваш рейтинг: @if (ViewBag.UserRating != null)
                        {
                            <span>@ViewBag.UserRating</span>
                        }
                        else
                        {
                            <span>Не оцінено</span>
                        }
                    </h3>

                    <div style="display: flex; gap: 10px; align-items: center;">
                        <a asp-action="RateGame" asp-controller="Rating" asp-route-gameId="@Model.GameId"
                           class="btn btn-success" style="border: none;">
                            Оцінити гру
                        </a>

                        @if (ViewBag.UserRating > 0)
                        {
                            <form asp-action="DeleteRating" asp-controller="Rating" method="post"
                                  style="display: flex; align-items: center;">
                                <input type="hidden" name="gameId" value="@Model.GameId" />
                                <button type="submit" class="btn btn-danger" style="border: none; margin-top: 25px;"
                                        onclick="return confirm('Ви впевнені, що хочете видалити свій рейтинг?')">
                                    Видалити рейтинг
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
            @if (User.Identity.IsAuthenticated)
            {
            <div>
                    <form id="gameListForm" asp-controller="GameList" asp-action="ToggleGameList" method="post">
                        <input type="hidden" name="gameId" value="@Model.GameId" />

                        <button type="submit" id="gameListButton" class="btn @(ViewBag.IsInGameList ? "btn-danger" : "btn-outline-primary")" style="border: none;">
                            <span id="gameListIcon">
                                @(ViewBag.IsInGameList ? "📌 Видалити зі списку" : "⭐ Додати в список")
                            </span>
                        </button>
                    </form>
            </div>
            }
        </div>
    </div>

    @if (Model.Screenshots != null && Model.Screenshots.Any())
    {
        <div id="screenshotSlider" class="carousel slide my-5" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < Model.Screenshots.Count; i += 3) 
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="row">
                            @for (int j = i; j < i + 3 && j < Model.Screenshots.Count; j++)
                            {
                                <div class="col-4">
                                    <img src="@Model.Screenshots.ToList()[j].ScreenshotUrl" class="d-block w-100" alt="Screenshot" style="height: 400px; object-fit: cover;">
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#screenshotSlider" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Попереднє</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#screenshotSlider" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Наступне</span>
            </button>
        </div>
    }
     @if (User.IsInRole("admin"))
    {
        <div class="screenshot-form-container mb-5">
            <form asp-controller="Screenshot" asp-action="AddScreenshot" method="post" class="screenshot-form">
                <input type="hidden" name="gameId" value="@Model.GameId" />
                <label>Додати скріншот:</label>
                <input type="text" name="screenshotUrl" placeholder="URL зображення" class="form-control mb-2" />
                <button type="submit" class="btn btn-success">Додати фото</button>
            </form>
        </div>
    }
   

    @if (User.IsInRole("admin"))
    {
        <div class="screenshot-form-container mb-5">
            <form asp-controller="Video" asp-action="AddTrailer" method="post" class="screenshot-form">
            <input type="hidden" name="gameId" value="@Model.GameId" />
            <label for="trailerUrl">Введіть URL трейлера:</label>
            <input type="text" id="trailerUrl" name="url" required class="form-control mb-2" />

            <button type="submit" class="btn btn-success">Додати трейлер</button>
        </form>
        </div>

        @if (User.IsInRole("admin"))
        {
            @foreach (var video in Model.GameVideos)
            {
                <form asp-action="Delete" asp-controller="Video" method="post"
                      onsubmit="return confirmDelete(event, this)" class="delete-form">
                    <input type="hidden" name="id" value="@video.VideoId" />
                    <button type="submit" class="btn btn-danger btn-sm" style=" margin-bottom: 10px;">
                        <i class="bi bi-trash"></i> Видалити
                    </button>
                </form>
            }
        }
        <script>
            function confirmDelete(event, form) {
                event.preventDefault();

                if (confirm("Ви впевнені, що хочете видалити це відео?")) {
                    form.submit();
                }
            }
        </script>
    }

    @{
        var trailer = Model.GameVideos.FirstOrDefault(v => v.Type == "trailer");
    }

    @if (trailer != null)
    {
        <div class="trailer-container">
            <iframe width="100%" height="400"
                    src="@trailer.VideoUrl.Replace("watch?v=", "embed/")"
                    frameborder="0" allowfullscreen>
            </iframe>
        </div>
    }
    @if (User.Identity.IsAuthenticated && !Model.IsExpected)
    {
        <div>
            <a asp-action="Create" asp-controller="Review" asp-route-gameId="@Model.GameId" class="btn btn-success mb-5" style="border:none;">Написати рецензію</a>
        </div>
    }
    <h3>Рецензії</h3>
    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        @foreach (var review in Model.Reviews)
        {
            <div class="review" style="background: #e3f2fd; padding: 10px; margin-bottom: 10px;">
                <p class="review-header">
                    <strong>@review.User.FullName</strong> - @review.DatePosted?.ToString("dd.MM.yyyy")
                </p>
                <p class="review-text" style="white-space: pre-wrap; word-wrap: break-word; max-width: 100%;">
                    @review.ReviewText
                </p>

                <div class="review-votes" style="display: flex; align-items: center; gap: 15px;">
                    <div class="vote-container" style="display: flex; align-items: center; gap: 5px;">
                        <button onclick="voteReview(@review.ReviewId, true)" class="btn btn-sm vote-btn" style="margin-top: 0px;">
                            👍
                        </button>
                        <span id="likes-count-@review.ReviewId" style="font-weight: bold;">@review.Likes</span>
                    </div>

                    <div class="vote-container" style="display: flex; align-items: center; gap: 5px;">
                        <button onclick="voteReview(@review.ReviewId, false)" class="btn btn-sm vote-btn" style="margin-top: 0px;">
                            👎
                        </button>
                        <span id="dislikes-count-@review.ReviewId" style="font-weight: bold;">@review.Dislikes</span>
                    </div>
                </div>

                <script>
                    function voteReview(reviewId, isLike) {
                        fetch(`/Review/VoteReview?reviewId=${reviewId}&isLike=${isLike}`, {
                            method: "POST"
                        })
                            .then(response => response.json())
                            .then(data => {
                                document.getElementById(`likes-count-${reviewId}`).textContent = data.likes;
                                document.getElementById(`dislikes-count-${reviewId}`).textContent = data.dislikes;
                            });
                    }
                </script>

                @if (User.IsInRole("admin"))
                {
                    <form asp-action="Delete" asp-controller="Review" method="post" onsubmit="return confirmDelete(event, this)" class="delete-form">
                        <input type="hidden" name="id" value="@review.ReviewId" />
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Видалити</button>
                    </form>
                    <script>
                        function confirmDelete(event, form) {
                        event.preventDefault();

                        if (confirm("Ви впевнені, що хочете видалити цю рецензію?")) {
                        form.submit();
                        }
                        }
                    </script>
                }
            </div>
        }
    }
    else
    {
        <p>Немає рецензій для цієї гри.</p>
    }
</div>


<style>
    .trailer-container {
    position: relative;
    width: 100%;
    max-width: 800px; 
    margin: 20px auto; 
    padding: 10px; 
    border: 1px solid #ddd; 
    border-radius: 8px; 
    background-color: #000; 
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.3); 
}

    .trailer-container iframe {
        border-radius: 8px; 
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2); 
    }

    .vote-btn {
        padding: 5px 12px;
        font-size: 1.2rem;
        cursor: pointer;
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

        .vote-btn:hover {
            transform: scale(1.1);
        }

    .vote-container {
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .vote-container span {
            font-size: 1rem;
            font-weight: bold;
            margin-left: 5px;
        }
}
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $("#gameListForm").submit(function (e) {
            e.preventDefault(); // Зупиняємо стандартну відправку форми

            $.ajax({
                url: $(this).attr("action"),  // Отримуємо URL з атрибуту `action`
                type: "POST",
                data: $(this).serialize(),  // Передаємо форму
                success: function (data) {
                    if (data.isInGameList) {
                        $("#gameListButton").removeClass("btn-outline-primary").addClass("btn-danger");
                        $("#gameListIcon").html("📌 Видалити зі списку");
                    } else {
                        $("#gameListButton").removeClass("btn-danger").addClass("btn-outline-primary");
                        $("#gameListIcon").html("⭐ Додати в список");
                    }
                },
                error: function () {
                    alert("Помилка! Спробуйте ще раз.");
                }
            });
        });
    });
</script>
