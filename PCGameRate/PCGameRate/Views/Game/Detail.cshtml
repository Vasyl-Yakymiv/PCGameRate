@model Game

<div class="container mt-5">
    <div class="row">
      
        <div class="col-md-6">
            <img src="@Model.Image" class="img-fluid rounded shadow" alt="Game Image" />
        </div>

       
        <div class="col-md-6">
            <h1>@Model.Title</h1>
            <p class="text-muted"></p>
            <p>@Model.Description</p>
            <div class="d-flex align-items-center">
                <i class="fas fa-gamepad text-warning me-2" style="font-size: 24px;"></i>
                <span style="font-size: 20px;"> @Model.RatingAverage / 10</span>
            </div>
           @if (User.Identity.IsAuthenticated)
           {  
            <div>
                <h3>
                    Ваш рейтинг: @if (ViewBag.UserRating != null)
                    {
                        <span>@ViewBag.UserRating</span>
                    }
                    else
                    {
                        <span>Не оцінено</span>
                    }
                </h3>
                <a asp-action="RateGame" asp-controller="Rating" asp-route-gameId="@Model.GameId" class="btn btn-success">
                    Оцінити гру
                </a>
                </div>
            }
        </div>
    </div>

    <div class="mt-5">
        <h3>Gallery</h3>
        <div id="game-gallery" class="carousel slide" data-bs-ride="carousel">
            @* <div class="carousel-inner">
                @for (var i = 0; i < Model.Image.Count; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@Model.Images[i]" class="d-block w-100 rounded shadow" alt="Gallery Image @i" />
                    </div>
                }
            </div> *@
            <button class="carousel-control-prev" type="button" data-bs-target="#game-gallery" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#game-gallery" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>

   @*  <!-- Рецензії -->
    <div class="mt-5">
        <h3>Reviews</h3>
        @if (Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@review.Author</h5>
                        <p class="card-text">@review.Content</p>
                        <p class="text-muted small">Posted on @review.DatePosted.ToString("MMMM dd, yyyy")</p>
                    </div>
                </div>
            }
        }
        else
        {
            <p>No reviews yet. Be the first to review this game!</p>
        }
    </div> *@
</div>